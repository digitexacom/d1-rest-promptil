/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "d1-rest-promptil",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "promptil-db",
          "database_id": "e652a7bf-492b-4905-90f4-1b29f483a608"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "b954970ae7f043bf901323e31ca71e66",
            "binding": "SECRET",
            "secret_name": "promptil-db"
        }
    ],
	"observability": {
		"enabled": true
	}
}
